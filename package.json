{
  "name": "kitty-english-garden",
  "productName": "Kitty英语乐园",
  "version": "1.1.0",
  "description": "零成本、全离线、完全免费的 Kitty 粉主题英语学习应用：小学一年级到高三分级单词闯关 + 情景对话 + 单词游戏（网页版 + Windows 桌面 exe 双端交付）",
  "main": "electron/main.js",
  "author": "Kitty English Garden Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "serve": "node scripts/dev-server.js",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "icon": "electron scripts/electron-gen-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "onnxruntime-web": "^1.21.0-dev.20250206-d981b153d3"
  },
  "build": {
    "appId": "com.kitty.englishgarden",
    "productName": "Kitty英语乐园",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KittyEnglishGarden-${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "KittyEnglishGarden-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KittyEnglishGarden-Setup-${version}.${ext}"
    }
  }
}
